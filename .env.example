# Disaster Response Application Environment Configuration
# Copy this file to .env and customize the values for your environment

# Flask Configuration
SECRET_KEY=your-secure-secret-key-here
FLASK_ENV=development
HOST=0.0.0.0
PORT=3000

# Model Configuration
# Google Drive Model ID for automatic model download
# Replace with actual Google Drive file ID for production deployment
GDRIVE_MODEL_ID=YOUR_GOOGLE_DRIVE_FILE_ID

# Security Configuration
# CSRF token expiry settings
# Set to '1' to disable CSRF expiry for long development sessions (dev only)
CSRF_TIME_LIMIT_NONE=0

# Session/Cookie Configuration
# Allow third-party cookies for embedded contexts (1=allow, 0=block)
ALLOW_THIRD_PARTY_COOKIES=1
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# Logging Configuration
LOG_LEVEL=INFO

# Development/Testing Flags
# Add any development-specific environment variables here