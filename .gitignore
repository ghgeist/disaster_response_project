# Python
.venv
__pycache__
*.pyc

# Machine learning model files
*.pkl.gz

# Ignore experimental models (can be large)
*.pkl

# BUT: Track production models (small, important for reproducibility)
# Production models are named: *_prod_*.pkl
!model/*_prod_*.pkl

# Also track production threshold files (small JSON, critical for deployment)
!model/*_prod_*_thresholds.json

# Logging files
*.log

# VSCode
.vscode/

# Security: never commit local session/cookie/token artifacts
token.txt
cookies.txt
*.cookies
*.session
*.sess

# Backup files (generated during model promotion)
*.bak

# Node.js / npm
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
*.min.js
*.min.css

# React / Vite dashboard (built from _vendor/figma_make; copy dist/ -> app/static/dashboard/)
# We WANT to track these assets so deployment doesn't require a node build step
# app/static/dashboard/assets/

# Vite/React env (secrets, local overrides)
.env
.env.local
.env.*.local

# Vendor directories
# ALLOW figma_make so we track the source code
!_vendor/figma_make/

# ...but ignore its dependencies and build artifacts
_vendor/figma_make/node_modules/
_vendor/figma_make/dist/

# --- Catch accidental weird files
=*