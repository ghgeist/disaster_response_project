modules = ["python-3.12", "web"]
run = "python run.py"

[nix]
channel = "stable-25_05"       # your current channel is fine
pkgs = ["file", "python312Packages.pylint", "stdenv.cc.cc.lib", "zlib"]

[deployment]
run = ["sh", "-c", "python run.py"]

[agent]
expertMode = true

[[ports]]
localPort = 3000
externalPort = 80

[workflows]
runButton = "Run"
