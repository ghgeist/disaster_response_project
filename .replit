modules = ["nodejs-20", "python-3.12", "web"]
run = "python run.py"

[nix]
channel = "stable-25_05"                                                # your current channel is fine
pkgs = ["file", "python312Packages.pylint", "stdenv.cc.cc.lib", "zlib"]
packages = ["imagemagick_light"]

[deployment]
build = [
  "sh",
  "-c",
  "pip install -r requirements.txt && python -m nltk.downloader -d /home/runner/nltk_data stopwords punkt wordnet punkt_tab",
]
run = [
  "sh",
  "-c",
  "gunicorn --bind 0.0.0.0:5000 --workers 1 --timeout 120 --max-requests 100 --max-requests-jitter 20 wsgi:application",
]
deploymentTarget = "autoscale"


[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Flask Server"

[[workflows.workflow]]
name = "Flask Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "gunicorn --bind 0.0.0.0:5000 --workers 1 --timeout 120 --max-requests 100 --max-requests-jitter 20 wsgi:application"
waitForPort = 5000
