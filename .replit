modules = ["python-3.12", "web"]
run = "python app/run.py"

[nix]
channel = "stable-25_05"

[deployment]
run = ["sh", "-c", "python app/run.py"]

[agent]
expertMode = true

[[ports]]
localPort = 3000
externalPort = 80

[workflows]
runButton = "Run"

[[workflows.workflow]]
name = "Run"
author = 39844655
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && python -m app.app"
